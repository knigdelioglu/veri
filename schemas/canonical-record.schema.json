{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "canonical-record.schema.json",
  "title": "TDE Rubric Grading Canonical Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "schema_version", "modality", "language", "grade", "task", "rubric", "student_response", "gold_evaluation", "metadata"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^tde(09|10|11|12)-(written|speaking|listening)-[0-9]{6}$"
    },
    "schema_version": {"const": "1.0"},
    "modality": {"enum": ["written", "speaking", "listening"]},
    "language": {"const": "tr"},
    "grade": {"type": "integer", "minimum": 9, "maximum": 12},
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt", "context", "max_score"],
      "properties": {
        "prompt": {"type": "string", "minLength": 1},
        "context": {"type": ["string", "null"]},
        "max_score": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "rubric": {"$ref": "rubric.schema.json"},
    "student_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "source", "observations"],
      "properties": {
        "text": {"type": "string"},
        "source": {"enum": ["manual", "teacher_corrected", "verified_ocr", "verified_stt"]},
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "value", "source"],
            "properties": {
              "label": {"type": "string", "minLength": 1},
              "value": {"type": "string", "minLength": 1},
              "source": {"const": "teacher"}
            }
          }
        }
      }
    },
    "gold_evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion_results", "total_score", "max_score", "needs_review", "review_reason", "overall_feedback"],
      "properties": {
        "criterion_results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["criterion_id", "score", "evidence", "justification"],
            "properties": {
              "criterion_id": {"type": "string", "minLength": 1},
              "score": {"type": "number", "minimum": 0},
              "evidence": {
                "type": "array",
                "items": {"type": "string", "minLength": 1}
              },
              "justification": {"type": "string", "minLength": 1}
            }
          }
        },
        "total_score": {"type": "number", "minimum": 0},
        "max_score": {"type": "number", "exclusiveMinimum": 0},
        "needs_review": {"type": "boolean"},
        "review_reason": {"type": ["string", "null"]},
        "overall_feedback": {"type": "string"}
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "split", "created_at", "tags", "pii_reviewed", "subject_group_id", "exam_family", "question_family", "provenance"],
      "properties": {
        "status": {"enum": ["draft", "annotated", "teacher_verified", "quarantined"]},
        "split": {"enum": ["train", "validation", "test", "benchmark", null]},
        "created_at": {"type": "string", "format": "date"},
        "tags": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "pii_reviewed": {"type": "boolean"},
        "subject_group_id": {"type": ["string", "null"]},
        "exam_family": {"type": ["string", "null"]},
        "question_family": {"type": ["string", "null"]},
        "provenance": {"enum": ["synthetic", "real_anonymized"]}
      }
    }
  }
}
