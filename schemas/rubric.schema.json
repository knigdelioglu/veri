{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rubric.schema.json",
  "title": "TDE Rubric",
  "type": "object",
  "additionalProperties": false,
  "required": ["rubric_id", "version", "criteria"],
  "properties": {
    "rubric_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion_id", "name", "description", "max_score", "scoring_anchors", "evidence_sources"],
        "properties": {
          "criterion_id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "max_score": {"type": "number", "exclusiveMinimum": 0},
          "scoring_anchors": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["score", "description"],
              "properties": {
                "score": {"type": "number", "minimum": 0},
                "description": {"type": "string", "minLength": 1}
              }
            }
          },
          "evidence_sources": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": ["response_text", "task_context", "audio_delivery", "teacher_observation"]
            }
          }
        }
      }
    }
  }
}
