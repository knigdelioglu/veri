*.mp3
*.m4a
*.aac
*.flac
*.mp4
*.mov
*.pdf
*.png
*.jpg
*.jpeg
*.heic
*.tiff

# Generated training exports are reproducible from canonical records.
exports/**/*.jsonl
exports/**/*.parquet

# Temporary files
*.tmp
*.bak
.cache/
