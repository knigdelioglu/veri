{
  "version": "1.0",
  "default_phase": "v1",
  "phases": {
    "pilot": {"target_records": 500},
    "iteration_1": {"target_records": 1500},
    "iteration_2": {"target_records": 3000},
    "v1": {"target_records": 6000}
  },
  "target_distribution": {
    "modality": {
      "written": 0.50,
      "speaking": 0.25,
      "listening": 0.25
    },
    "grade": {
      "9": 0.25,
      "10": 0.25,
      "11": 0.25,
      "12": 0.25
    },
    "response_quality": {
      "full_correct": 0.20,
      "high_partial": 0.20,
      "mid_partial": 0.20,
      "low_partial": 0.15,
      "incorrect": 0.10,
      "blank_irrelevant": 0.05,
      "borderline": 0.10
    }
  },
  "target_ranges": {
    "needs_review": [0.08, 0.12],
    "hard_case": [0.15, 0.20],
    "adversarial": [0.03, 0.05],
    "dual_review_overall": [0.20, 1.00]
  },
  "question_coverage": {
    "answers_per_exact_task": [8, 20],
    "answers_per_question_family": [20, 40],
    "target_question_families_by_phase": {
      "pilot": 30,
      "iteration_1": 75,
      "iteration_2": 150,
      "v1": 300
    }
  },
  "rubric_diversity": {
    "min_distinct_criterion_counts": 4,
    "preferred_criterion_count_range": [2, 5]
  },
  "review_policy": {
    "teacher_verified_min_reviews": 1,
    "evaluation_split_min_reviews": 2,
    "borderline_min_reviews": 2,
    "needs_review_min_reviews": 2
  }
}
